{
  "api_version": "noetl.io/v2",
  "document_kind": "Playbook",
  "enabled_tool_kinds": [
    "artifact",
    "container",
    "duckdb",
    "ducklake",
    "gateway",
    "gcs",
    "http",
    "iterator",
    "nats",
    "noop",
